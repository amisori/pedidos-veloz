# ============================================================
# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo: cp .env.example .env
# NUNCA commite o .env com valores reais
# ============================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_senha
POSTGRES_DB=pedidos_db

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Pagamentos (use sandbox em dev)
PAYMENT_GATEWAY_URL=https://sandbox.gateway.example.com
PAYMENT_API_KEY=sandbox-key-dev-0000
